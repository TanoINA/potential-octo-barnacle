{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherAgent",
  "version": "0.3.0",
  "identifier": "com.tano.aetheragent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AetherAgent",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true, "windows": { "installMode": "basicUi" } } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
